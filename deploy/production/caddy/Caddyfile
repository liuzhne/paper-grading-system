# 生产（AWS Lightsail 单机）的入口。证书由 Let's Encrypt 自动签发与续期。
#
# 安全头与缓存头照抄 vercel.json；内网用的 deploy/Caddyfile 另有一份安全头，
# 改的时候两边一起改。

{$PGS_SITE_ADDRESS} {
	encode zstd gzip

	request_body {
		max_size 50MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# 评分助手的工作区以同源 iframe 嵌入现有页面；跨站嵌入仍被禁止。
		X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy "frame-ancestors 'self'"
		Referrer-Policy "same-origin"
		-Server
	}

	# 带内容哈希的构建产物，可以长期缓存；入口页每次都要回源确认。
	@assets path /workbench/assets/*
	header @assets {
		Cache-Control "public, max-age=31536000, immutable"
		defer
	}

	@entry {
		path / /login /register /reset-password /workbench /workbench/*
		not path /workbench/assets/*
	}
	header @entry {
		Cache-Control "public, max-age=0, must-revalidate"
		defer
	}

	reverse_proxy app:8000 {
		# 发版换 app 容器的几秒空档里，新请求先等着，后端起来后再转发。
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}
