# ── 基础 ────────────────────────────────────────────────────────────────
# Web/Postgres 形态用此 DATABASE_URL；CLI 本地形态默认用 ~/.paper-grading/cli.db，无需配。
DATABASE_URL=postgresql+psycopg://paper:paper@localhost:5432/paper_grading
STORAGE_ROOT=storage
# 生产 Web：文件经签名 URL 直传 Supabase 私有桶，不经过 Vercel Function。
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://replace-with-project-ref.supabase.co
# SUPABASE_SECRET_KEY=replace-with-server-only-secret-key
# SUPABASE_STORAGE_BUCKET=paper-grading-private
# MAX_UPLOAD_SIZE_MB=50
# DIRECT_UPLOAD_MAX_SIZE_MB=50
# DIRECT_UPLOAD_TUS_THRESHOLD_MB=6
# PAPER_PARSE_LEASE_SECONDS=600

# ── LLM 选择（核心）─────────────────────────────────────────────────────
# 默认 LLM_PROVIDER=mock：零配置、不触网，可直接跑通流程做演示/自测。
# 要真实评分，从下面四套预设里【取消注释一套】。云=外呼厂商；本地=连本地端口、零外呼。
# 自检：`pgs check`（或 Web「测试 LLM 连接」）会显示 network=offline/local/external。
LLM_PROVIDER=mock
LLM_FALLBACK_TO_MOCK=true

# 预设 ①【主推】本地·llama.cpp —— 全本地离线，不依赖网络
#   先起服务：llama-server -m <模型.gguf> --port 8080（自带 OpenAI 兼容端点 /v1）
# LLM_PROVIDER=local
# LOCAL_LLM_BASE_URL=http://localhost:8080/v1
# LOCAL_LLM_MODEL=local-model           # llama.cpp 忽略请求名、用已加载模型
# LOCAL_LLM_API_KEY=                     # 本地通常无需鉴权，留空即可

# 预设 ② 本地·Ollama —— 同样全本地离线
#   先起服务：ollama serve；ollama pull qwen2.5:14b
# LLM_PROVIDER=local
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:14b
# LOCAL_LLM_API_KEY=

# 预设 ③ 云·OpenAI（外呼）
# LLM_PROVIDER=openai
# OPENAI_API_KEY=replace-with-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini

# 预设 ④ 云·智谱 / 其它 OpenAI 兼容厂商（外呼）
# LLM_PROVIDER=openai_compatible
# OPENAI_COMPATIBLE_API_KEY=replace-with-api-key
# OPENAI_COMPATIBLE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_COMPATIBLE_MODEL=glm-4.7-flash
# OPENAI_COMPATIBLE_PROVIDER_NAME=zhipu

# 预设 ⑤ 云·Google AI Studio / Gemini（外呼，OpenAI 兼容端点）
# LLM_PROVIDER=openai_compatible
# OPENAI_COMPATIBLE_API_KEY=replace-with-google-ai-studio-key
# OPENAI_COMPATIBLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_COMPATIBLE_MODEL=gemini-3.5-flash
# OPENAI_COMPATIBLE_PROVIDER_NAME=google_ai_studio
# OPENAI_COMPATIBLE_RESPONSE_FORMAT_JSON=true
# OPENAI_COMPATIBLE_THINKING_TYPE=

# ── 可选：Google Sheets 导出（网络，离线形态请勿启用）────────────────────
# 部署 docs/google_apps_script_webapp.gs 后填。CLI 全本地离线时保持 mock。
SHEET_WRITER_PROVIDER=mock
# SHEET_WRITER_PROVIDER=google_sheets
# GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/replace-with-deployment-id/exec
# GOOGLE_SHEETS_WEBAPP_SECRET=replace-with-shared-secret
