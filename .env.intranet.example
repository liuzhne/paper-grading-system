# Intranet pilot deployment template.
# Copy to .env.intranet, edit secrets/host, then run:
#   docker compose --env-file .env.intranet up -d --build

# ---- Site / reverse proxy -------------------------------------------------
# Use an internal DNS name or a hosts-file name, for example:
#   https://paper-grading.lan
# Caddy uses an internal CA. Install its root certificate on pilot machines.
PAPER_GRADING_SITE=https://paper-grading.local
CADDY_MAX_UPLOAD_SIZE=50MB

# ---- Postgres --------------------------------------------------------------
POSTGRES_DB=paper_grading
POSTGRES_USER=paper
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# ---- App security ----------------------------------------------------------
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=replace-with-strong-login-password
AUTH_SECRET=replace-with-random-32-plus-char-secret
AUTH_TOKEN_TTL_SECONDS=86400

# ---- Storage / upload ------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50

# ---- LLM -------------------------------------------------------------------
# Intranet pilot default: mock is safe for workflow testing and never leaves
# the network. Switch to Google AI Studio / local / another approved provider
# when real scoring is required.
LLM_PROVIDER=mock
LLM_FALLBACK_TO_MOCK=false
LLM_DEBUG_LOG_ENABLED=false
LLM_CACHE_ENABLED=true

# Google AI Studio / Gemini API example. This uses Google's OpenAI-compatible
# endpoint, so it works with the existing openai_compatible adapter.
# LLM_PROVIDER=openai_compatible
# OPENAI_COMPATIBLE_API_KEY=replace-with-google-ai-studio-key
# OPENAI_COMPATIBLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_COMPATIBLE_MODEL=gemini-3.5-flash
# OPENAI_COMPATIBLE_PROVIDER_NAME=google_ai_studio
# OPENAI_COMPATIBLE_RESPONSE_FORMAT_JSON=true
# OPENAI_COMPATIBLE_THINKING_TYPE=

# Local private model example. If the model runs on the Docker host, keep
# host.docker.internal; if it runs as another container, use that service name.
# LLM_PROVIDER=local
# LOCAL_LLM_BASE_URL=http://host.docker.internal:8080/v1
# LOCAL_LLM_MODEL=local-model
# LOCAL_LLM_API_KEY=

# Other OpenAI-compatible cloud/provider example.
# LLM_PROVIDER=openai_compatible
# OPENAI_COMPATIBLE_API_KEY=replace-with-api-key
# OPENAI_COMPATIBLE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_COMPATIBLE_MODEL=glm-4.7-flash
# OPENAI_COMPATIBLE_PROVIDER_NAME=zhipu
# OPENAI_COMPATIBLE_RESPONSE_FORMAT_JSON=true
# OPENAI_COMPATIBLE_THINKING_TYPE=disabled

# ---- Sheets / offline boundary --------------------------------------------
# Keep mock for intranet pilot unless online Google Sheets export is approved.
SHEET_WRITER_PROVIDER=mock
SHEET_FALLBACK_TO_MOCK=false
OFFLINE_MODE=false

# GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/.../exec
# GOOGLE_SHEETS_WEBAPP_SECRET=replace-with-shared-secret
